# AI assistant LLM config. Copy to `.env.local` and fill in.
# The proxy (/api/agent, dev only) is provider-agnostic — any OpenAI-compatible
# endpoint works. The key stays server-side and never reaches the browser.
# If nothing is set here, the assistant falls back to the built-in Local driver
# (no key, deterministic) — the app always works offline.

# --- Cerebras (gpt-oss-120b) ---
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=csk-your-cerebras-key
LLM_MODEL=gpt-oss-120b

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4o-mini

# --- Groq ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk-your-groq-key
# LLM_MODEL=llama-3.3-70b-versatile

# --- Local Ollama (no key needed) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b

# --- Cloud plan sync (Supabase) — OPT-IN, off by default ---
# docs/design/cloud-sync.md. Unset = local-only (IndexedDB), the default.
# These VITE_ vars ARE bundled into the browser; the anon key is browser-safe
# (every request is still gated by Row-Level Security). Copy to .env.local.
# VITE_CLOUD_SYNC=1
# VITE_SUPABASE_URL=https://nkjigrogbobtklotupkt.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...

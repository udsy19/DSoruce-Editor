# Rust
/target
**/target

# Node
node_modules
web/dist
deploy/dist-server

# Dev-only plan store (vite plansStore middleware; prod uses PLANS_DIR)
web/.dev-plans
deploy/plans

# Generated wasm bindings (built via `make wasm`). The build artifacts are
# force-tracked (see below) so Vercel — which has no Rust toolchain — can build
# the SPA from them. wasm-pack drops a `web/src/wasm/.gitignore` containing `*`;
# the specific artifacts are committed with `git add -f` and stay tracked, so a
# `make wasm` rebuild shows them as modified (commit the new wasm to redeploy).
web/src/wasm/.gitignore

# Env / secrets (LLM keys live here — never commit)
.env
.env.*
!.env.example

# Misc
*.log
.DS_Store

# Browser-test artifacts
.playwright-mcp/
/*.png

# Generated from the sample DWG via dwg2dxf
samples/*.dxf
.claude/worktrees/

# Qbiq reference samples (kept on disk, not in git — large binaries)
docs/reference/qbiq/*.zip
docs/reference/qbiq/extracted/Rendered Images Samples from Qbiq/
docs/reference/qbiq/extracted/**/__MACOSX/
**/.DS_Store
docs/reference/rayon-output/*.pdf

# generated knowledge graph (rebuild with /graphify)
graphify-out/
